  <ItemGroup>
    <!-- The actual app code under test. -->
    <Compile Include="..\..\TubeMailGorilla.Maui.Unlocked\Services\Mp4FragmentRemuxer.cs" Link="Mp4FragmentRemuxer.cs" />
  </ItemGroup>

</Project>
