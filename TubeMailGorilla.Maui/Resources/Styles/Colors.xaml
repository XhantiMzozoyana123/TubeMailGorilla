<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

        <!-- TubeMail Gorilla palette (matches web app) -->
    <Color x:Key="Primary">#FF003B</Color>
    <Color x:Key="PrimaryDark">#CC002E</Color>
    <Color x:Key="PrimaryLight">#FF4D73</Color>

    <Color x:Key="Secondary">#4DA3FF</Color>
    <Color x:Key="SecondaryLight">#93C5FF</Color>

    <Color x:Key="Accent">#FF003B</Color>
    <Color x:Key="AccentLight">#FF4D73</Color>

    <!-- Danger -->
    <Color x:Key="Danger">#FF003B</Color>
    <Color x:Key="DangerLight">#FF4D73</Color>

    <!-- Depth surfaces (match web: #08090d, #0f1118, #141724) -->
    <Color x:Key="Background">#08090D</Color>
    <Color x:Key="Surface">#0F1118</Color>
    <Color x:Key="SurfaceVariant">#141724</Color>
    <Color x:Key="Border">#333F4A</Color>
    <Color x:Key="BorderLight">#4A5568</Color>
    <Color x:Key="CardBackground">#0F1118</Color>
    

    
        <!-- Text on dark -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#D1D5DB</Color>
    <Color x:Key="TextTertiary">#9CA3AF</Color>
    <Color x:Key="TextInverse">#08090D</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <!-- App-wide gradient background (no image assets) -->
    <LinearGradientBrush x:Key="BackgroundGradient">
        <GradientStop Color="#08090D" Offset="0" />
        <GradientStop Color="#0F1118" Offset="1" />
    </LinearGradientBrush>

    <!-- Semantic brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>
    
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource SecondaryLight}"/>
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}"/>
    
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLight}"/>
    
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariant}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>
    <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource TextInverse}"/>

</ResourceDictionary>
