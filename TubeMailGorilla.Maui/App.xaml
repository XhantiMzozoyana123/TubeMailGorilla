<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TubeMailGorilla.Maui"
             x:Class="TubeMailGorilla.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:FieldToDescriptionConverter x:Key="FieldToDescription" xmlns:converters="clr-namespace:TubeMailGorilla.Maui.Converters" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
