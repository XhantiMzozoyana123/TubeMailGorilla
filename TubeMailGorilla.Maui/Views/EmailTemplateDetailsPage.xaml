<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TubeMailGorilla.Maui.Views.EmailTemplateDetailsPage"
             Title="Template">
    <Grid Padding="20" RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="EMAIL TEMPLATE" Style="{StaticResource SectionTitleStyle}" />
            <Label Text="Name this template and fill in the subject and body used when sending campaigns."
                   Style="{StaticResource DescriptionStyle}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" HorizontalOptions="FillAndExpand">
            <VerticalStackLayout Spacing="12">
                <Entry x:Name="NameEntry" Placeholder="Template name (e.g. Outreach)" />
                <Entry x:Name="SubjectEntry" Placeholder="Email subject line" />
                <Editor x:Name="BodyEditor"
                        Placeholder="Write your email body here. Use tokens like [name], [email], [channel], [video-title], [descr], [channel-name], [first-name], [last-name]."
                        HeightRequest="180" />
            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="2" Spacing="12" HorizontalOptions="Center">
            <Button Text="Save" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSave" />
            <Button Text="Cancel" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnCancel" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
