<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TubeMailGorilla.Maui.Unlocked.Controls.CollapsibleCard">
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Frame BackgroundColor="{StaticResource Surface}"
                   BorderColor="{StaticResource Border}"
                   HasShadow="False"
                   CornerRadius="12"
                   Padding="0"
                   Margin="0,0,0,16">
                <VerticalStackLayout Spacing="0">
                    <Grid AutomationId="CardHeader"
                          ColumnDefinitions="*,Auto"
                          Padding="20,14">
                        <Label AutomationId="CardTitle"
                               FontFamily="Outfit"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center" />
                        <Label AutomationId="CardChevron"
                               Grid.Column="1"
                               Text="&#x25BE;"
                               FontSize="16"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />
                    </Grid>
                    <BoxView AutomationId="CardDivider" Color="{StaticResource BorderLight}" HeightRequest="1" />
                    <Grid Padding="20,4,20,20" RowDefinitions="Auto">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
