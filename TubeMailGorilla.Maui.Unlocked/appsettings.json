{
  "ApiSettings": {
    "BaseUrl": "https://api.tubemailgorilla.xyz",
    "WebAppUrl": "https://www.tubemailgorilla.xyz"
  },
  // LLM inference runs against the LOCAL Ollama daemon (no LLamaSharp/GGUF).
  // Only the endpoint and model NAMES live here - the weights are pulled into
  // Ollama itself. llama3:latest is the installed text model; OllamaVisionModel
  // is qwen3-vl:4b (vision-language: sees the [snapshot_ai] frames / the
  // "Identify Areas of Improvement" analysis). The vision tag can be emptied
  // again to fall back to transcript + metadata only.
  "LlmSettings": {
    "OllamaBaseUrl": "http://localhost:11434",
    "OllamaModel": "llama3:latest",
    "OllamaVisionModel": "qwen3-vl:4b",
    "MaxImagesPerRequest": 4,
    "MaxTokens": 512,
    "Temperature": 0.2,
    "MaxInputCharacters": 8000,
    "InferenceTimeoutSeconds": 300,
    "ModelKeepAliveMinutes": 60
  }
}