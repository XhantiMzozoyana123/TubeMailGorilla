{
  "ApiSettings": {
    "BaseUrl": "https://api.tubemailgorilla.xyz",
    "WebAppUrl": "https://www.tubemailgorilla.xyz"
  },
  // LLM inference runs against the LOCAL Ollama daemon (no LLamaSharp/GGUF).
  // Only the endpoint and model NAMES live here - the weights are pulled into
  // Ollama itself. TEXT work (extraction, icebreakers) runs on llama3:latest:
  // qwen3-vl is a reasoning model whose thinking trace cannot be disabled on
  // Ollama 0.40 (think=false and /no_think are both ignored - ollama/ollama#16945)
  // and custom icebreaker prompts were measured burning the whole token budget
  // on thinking and returning an EMPTY response. llama3 answers directly. The
  // VISION workload ([snapshot_ai] frames / video review) stays on qwen3-vl:4b;
  // empty the vision tag to fall back to transcript + metadata only.
  "LlmSettings": {
    "OllamaBaseUrl": "http://localhost:11434",
    "OllamaModel": "llama3:latest",
    "OllamaVisionModel": "qwen3-vl:4b",
    "OllamaContextSize": 8192,
    "MaxImagesPerRequest": 4,
    "MaxTokens": 1500,
    "Temperature": 0.2,
    "MaxInputCharacters": 8000,
    "InferenceTimeoutSeconds": 300,
    "ModelKeepAliveMinutes": 60,
    // ComfyUI img2img for [snapshot_ai]: repaint ONE frame per the {instruction}
    // instead of compositing 4 thumbnails. Empty base URL (default) = no image
    // model, token composites real frames. Set the URL once ComfyUI runs
    // locally (default port 8188) with an SD1.5/SDXL checkpoint in
    // ComfyUI/models/checkpoints, e.g.:
    //   "ComfyUiBaseUrl": "http://127.0.0.1:8188",
    //   "ComfyUiCheckpoint": "v1-5-pruned-emaonly.safetensors",
    "ComfyUiBaseUrl": "http://127.0.0.1:8188",
    "ComfyUiCheckpoint": "v1-5-pruned-emaonly.safetensors",
    "ComfyUiDenoise": 0.55,
    "ComfyUiSteps": 25,
    "ComfyUiTimeoutSeconds": 300
  }
}