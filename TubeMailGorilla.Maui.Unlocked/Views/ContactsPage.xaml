<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TubeMailGorilla.Maui.Unlocked.Models"
             x:Class="TubeMailGorilla.Maui.Unlocked.Views.ContactsPage"
             Title="Contacts">
    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="CONTACTS" Style="{StaticResource SectionTitleStyle}" Margin="0" />
            <Label Text="All of your extracted leads. Tap a lead to open it, or search / sort to find one fast."
                   Style="{StaticResource DescriptionStyle}" Margin="0" />
        </VerticalStackLayout>
        <Grid Grid.Row="1" ColumnDefinitions="*,170" ColumnSpacing="12">
            <SearchBar x:Name="SearchBarControl" Placeholder="Search name, email or channel" TextChanged="OnSearchTextChanged" Margin="0" />
            <Picker x:Name="SortPicker" Grid.Column="1" Title="Sort" Margin="0" SelectedIndexChanged="OnSortChanged" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Text="Add Contact" Style="{StaticResource PrimaryButtonStyle}" Margin="0" Clicked="OnAddContactClicked" />
            <Button x:Name="GenerateIcebreakersButton" Grid.Column="1" Text="Generate Icebreakers" Style="{StaticResource PrimaryButtonStyle}" Margin="0" Clicked="OnGenerateIcebreakersClicked" />
        </Grid>
        <Label x:Name="FreePlanBanner" Grid.Row="3" Style="{StaticResource DescriptionStyle}" TextColor="{StaticResource Primary}" Margin="0" IsVisible="False" />
        <ActivityIndicator x:Name="LoadingIndicator" Grid.Row="4" IsRunning="True" IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center" />
        <Frame Grid.Row="4" Margin="0" Padding="0" CornerRadius="12" HasShadow="False" BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Border}">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,10">
                    <Label x:Name="ContactsCountLabel" Text="Loading leads..." FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Delete All" Style="{StaticResource CompactDangerButtonStyle}" VerticalOptions="Center" Clicked="OnDeleteAllContactsClicked" />
                </Grid>
                <BoxView Grid.Row="1" Color="{StaticResource BorderLight}" HeightRequest="1" Margin="0" />
                <Grid Grid.Row="2">
                    <CollectionView x:Name="ContactsList" SelectionMode="Single" SelectionChanged="OnContactSelected" BackgroundColor="Transparent" VerticalScrollBarVisibility="Always" RemainingItemsThreshold="5" RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:EmailContact">
                                <SwipeView><SwipeView.RightItems><SwipeItems Mode="Execute"><SwipeItem Text="Delete" BackgroundColor="{StaticResource Danger}" Invoked="OnDeleteSwipeInvoked" /></SwipeItems></SwipeView.RightItems><Frame Margin="12,8,12,0" Padding="0" CornerRadius="12" HasShadow="False" BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Border}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12">
                                        <Frame WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" HasShadow="False" BackgroundColor="{StaticResource Primary}" VerticalOptions="Center">
                                            <Label Text="{Binding Initials}" TextColor="White" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Frame>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding DisplayName}" FontSize="15" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="{Binding Email}" FontSize="13" MaxLines="1" LineBreakMode="TailTruncation" TextColor="{StaticResource TextSecondary}" />
                                            <Label Text="{Binding DisplaySubtitle}" FontSize="12" MaxLines="1" LineBreakMode="TailTruncation" TextColor="{StaticResource TextTertiary}" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                            <Frame IsVisible="{Binding IsBlocked}" WidthRequest="60" HeightRequest="24" CornerRadius="12" Padding="4" BackgroundColor="{StaticResource Danger}" HasShadow="False" VerticalOptions="Center" Margin="0">
                                                <Label Text="Blocked" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Frame>
                                            <Label Text="&#x203A;" FontSize="24" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnContactTapped" />
                                    </Frame.GestureRecognizers>
                                </Frame></SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label x:Name="EmptyContactsLabel" Text="No contacts yet. Extract some leads from the Extract page." Style="{StaticResource EmptyStateStyle}" IsVisible="False" />
                </Grid>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>

