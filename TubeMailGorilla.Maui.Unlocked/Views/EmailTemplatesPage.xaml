<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TubeMailGorilla.Maui.Unlocked.Models"
             x:Class="TubeMailGorilla.Maui.Unlocked.Views.EmailTemplatesPage"
             Title="Email Templates">
    <Grid>
        <!-- Unlocked edition: templates are always available - no gate. -->
        <VerticalStackLayout Padding="20" Spacing="12">
        <VerticalStackLayout Spacing="4">
            <Label Text="EMAIL TEMPLATES" Style="{StaticResource SectionTitleStyle}" />
            <Label Text="Stored email templates. Add a new template, or tap a row to edit it."
                   Style="{StaticResource DescriptionStyle}" />
        </VerticalStackLayout>

        <ListView x:Name="TemplatesList"
                  SelectionMode="Single"
                  ItemSelected="OnTemplateSelected"
                  BackgroundColor="Transparent">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:EmailTemplate">
                    <ViewCell>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Padding="6,8" Spacing="2">
                                <Label Text="{Binding Name}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Subject}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"
                                       MaxLines="2"
                                       LineHeight="1.1" />
                                <Label Text="{Binding UpdatedAt, StringFormat='Updated {0:g}'}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextTertiary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Clicked="OnDeleteTemplateClicked"
                                    Text="Delete"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    BackgroundColor="Transparent"
                                    Padding="4"
                                    HeightRequest="32"
                                    WidthRequest="60" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Label x:Name="EmptyTemplatesLabel"
               Text="No email templates yet. Add one to start storing reusable campaigns."
               Style="{StaticResource EmptyStateStyle}"
               HorizontalOptions="Center"
               IsVisible="False" />

        <Button Text="Add Template"
                Style="{StaticResource SecondaryButtonStyle}"
                Clicked="OnAddTemplateClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
