<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TubeMailGorilla.Maui.Unlocked.Models"
             x:Class="TubeMailGorilla.Maui.Unlocked.Views.ContactDetailsPage">
    <!-- No nav bar and no "Contact Details" title: AppShell hides nav bars
         app-wide (see AppShell.xaml), and opting this one back in left either an
         ugly heading or an empty blank strip. The page matches every other page
         in the app instead, and the back affordance is an ordinary button at the
         top of the content. -->
    <Grid Padding="16" RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0" HorizontalOptions="FillAndExpand">
            <!--
                Every block of content is wrapped in a CardStyle Frame. This used
                to be one long stack with headings floating between loose fields,
                which made it hard to see where one thing ended and the next
                began. CardStyle already carries the app's surface colour, 1px
                border, 12px corner radius and 20px padding, so grouping the
                content this way costs no new styling and keeps the page in step
                with every other screen.
            -->
            <VerticalStackLayout Spacing="0">

                <Button x:Name="BackButton"
                        Text="←  Back to contacts"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Padding="0"
                        Margin="0,0,0,8"
                        HorizontalOptions="Start"
                        FontSize="13"
                        TextColor="{StaticResource Primary}"
                        Clicked="OnBackClicked" />

                <!-- ============================ CONTACT INFO ============================ -->
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="CONTACT INFO" Style="{StaticResource SectionTitleStyle}" />

                        <Label Text="NAME" Style="{StaticResource CaptionStyle}" Margin="0" />
                        <Entry x:Name="NameEntry" Placeholder="Full name" />

                        <Label Text="EMAIL" Style="{StaticResource CaptionStyle}" Margin="0" />
                        <Entry x:Name="EmailEntry" Placeholder="Email address" Keyboard="Email" />

                    </VerticalStackLayout>
                </Frame>

                <!-- ============================ LEAD CONTEXT ============================ -->
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8">

                        <Label Text="LEAD CONTEXT" Style="{StaticResource SectionTitleStyle}" />

                        <Label Text="{Binding Channel, StringFormat='Channel: {0}', TargetNullValue='Channel: (unknown)'}"
                               FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding VideoTitle, StringFormat='Latest video: {0}', TargetNullValue='Video: (unknown)'}"
                               FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding VideoDescription, StringFormat='Description: {0}', TargetNullValue='Description: (unknown)'}"
                               FontSize="12" TextColor="{StaticResource TextTertiary}"
                               LineBreakMode="WordWrap" MaxLines="3" />
                        <Label Text="{Binding ExtractedAt, StringFormat='Extracted: {0:g}'}"
                               FontSize="12" TextColor="{StaticResource TextTertiary}" />
                        <Label Text="{Binding IsEmailer, StringFormat='Newsletter sender: {0}'}"
                               FontSize="12" TextColor="{StaticResource TextTertiary}" />

                    </VerticalStackLayout>
                </Frame>

                <!--
                    Video snapshots captured during extraction. A CarouselView
                    (not a BindableLayout) is used deliberately: it is the only
                    MAUI layout that handles both horizontal paging and lazy
                    image loading, which matters once a lead carries a dozen
                    base64 JPEGs. It sits inside a ScrollView, so it is given an
                    explicit height (a nested CollectionView measured without
                    one renders nothing).
                -->
                <!-- ================================ ACTIONS ================================ -->
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="ACTIONS" Style="{StaticResource SectionTitleStyle}" />

                        <!--
                            The three things you can do with a lead. They were
                            previously split: Generate sat down in ICEBREAKERS
                            and Improve sat on its own above it, so the eye had to
                            travel between two blocks to find them. They are one
                            workflow, so they sit together.

                            Three equal columns rather than a
                            HorizontalStackLayout: the labels differ a lot in
                            length and auto-sizing would stretch the first button
                            and cram the last, so the row would stop reading as a
                            single control.
                        -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button x:Name="ActionIcebreakerButton"
                                    Grid.Column="0"
                                    Text="&#x2728; Icebreaker"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Clicked="OnGenerateIcebreakerClicked" />
                            <Button x:Name="ActionImprovementsButton"
                                    Grid.Column="1"
                                    Text="&#x1F50D; Video Review"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Clicked="OnIdentifyImprovementsClicked" />
                            <Button x:Name="ActionDownloadButton"
                                    Grid.Column="2"
                                    Text="&#x2B07; Save ZIP"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Clicked="OnDownloadSnapshotsClicked" />
                        </Grid>

                        <Label x:Name="ActionRowHintLabel"
                               FontSize="11"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource TextTertiary}"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>
                </Frame>

                <!-- ============================ VIDEO SNAPSHOTS ============================ -->
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">

                    <Label Text="VIDEO SNAPSHOTS" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <Label x:Name="SnapshotsHintLabel"
                           Text="A frame every 10 seconds of the video. Swipe to move through it."
                           Style="{StaticResource DescriptionStyle}" />

                <Grid x:Name="SnapshotsPanel" IsVisible="False" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CarouselView x:Name="SnapshotsCarousel"
                                   Grid.Row="0"
                                   HeightRequest="190"
                                   IsSwipeEnabled="True"
                                   IsBounceEnabled="False"
                                   PositionChanged="OnSnapshotPositionChanged">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="models:VideoSnapshotItem">
                                <Border Padding="0"
                                        StrokeThickness="0"
                                        BackgroundColor="Transparent">
                                    <Grid>
                                        <Image Source="{Binding Image, Converter={StaticResource Base64ToImageSource}}"
                                               Aspect="AspectFit" />
                                        <Label Text="{Binding TimestampLabel}"
                                               HorizontalOptions="End"
                                               VerticalOptions="Start"
                                               Margin="0,6,6,0"
                                               Padding="6,2"
                                               FontSize="11"
                                               FontFamily="JetBrainsMono"
                                               TextColor="White"
                                               BackgroundColor="#CC000000" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <!-- Position indicator + paging buttons: the carousel is swipe
                         first, and these make every snapshot reachable with a
                         mouse or keyboard too. -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                        <Button x:Name="PreviousSnapshotButton"
                                Grid.Column="0"
                                Text="◀"
                                WidthRequest="44"
                                Padding="0"
                                FontSize="14"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Clicked="OnPreviousSnapshotClicked" />
                        <Label x:Name="SnapshotCounterLabel"
                               Grid.Column="1"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}" />
                        <Button x:Name="NextSnapshotButton"
                                Grid.Column="2"
                                Text="▶"
                                WidthRequest="44"
                                Padding="0"
                                FontSize="14"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Clicked="OnNextSnapshotClicked" />
                    </Grid>

                    <!-- Jump to the moment the frame on screen was captured. -->
                    <Button x:Name="SnapshotWatchButton"
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            Text="Watch from this moment"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Clicked="OnWatchSnapshotClicked"
                            IsVisible="False" />
                </Grid>

                    <Label x:Name="NoSnapshotsLabel"
                           Text="This lead has no snapshots. They are captured during extraction, so only leads found after that ran will have them - or use Try again below to capture them now."
                           FontSize="12"
                           TextColor="{StaticResource TextTertiary}"
                           LineBreakMode="WordWrap"
                           IsVisible="False" />

                    <!--
                        Manual retry. Extraction captures frames as it goes and
                        never retries them, so a lead can end up with none at all
                        (download timed out, decoder failed, or the contact
                        predates snapshot capture). Rather than re-running a whole
                        keyword extraction for one lead, this re-runs just the
                        capture for this contact's video.
                    -->
                    <Grid x:Name="SnapshotRetryRow"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8"
                          Margin="0,8,0,0"
                          VerticalOptions="Center">
                        <Label x:Name="SnapshotRetryStatusLabel"
                               Grid.Column="0"
                               FontSize="11"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource TextTertiary}"
                               VerticalOptions="Center"
                               Text="Missing frames? Retry the capture for this lead's video." />
                        <ActivityIndicator x:Name="SnapshotCaptureIndicator"
                                           Grid.Column="1"
                                           IsRunning="False"
                                           IsVisible="False"
                                           VerticalOptions="Center" />
                        <Button x:Name="RetrySnapshotsButton"
                                Grid.Column="2"
                                Text="Try again"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Clicked="OnRetrySnapshotsClicked" />
                    </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- ======================= AREAS OF IMPROVEMENT ======================= -->
                <!--
                    Its own card and deliberately NOT nested inside the snapshots
                    card: the review works from the transcript and metadata as well
                    as the frames, so it has to stay available for a lead that has
                    no snapshots at all.
                -->
                <Frame Style="{StaticResource CardStyle}" x:Name="ImprovementsCard" IsVisible="False">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="AREAS OF IMPROVEMENT" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                        <Label Text="Editing notes aimed at raising watch time and engagement on this video."
                               Style="{StaticResource DescriptionStyle}" />

                        <VerticalStackLayout x:Name="ImprovementsPanel" IsVisible="False" Spacing="8">
                            <ActivityIndicator x:Name="ImprovementsIndicator"
                                               IsRunning="False"
                                               IsVisible="False"
                                               HorizontalOptions="Center" />
                            <Label x:Name="ImprovementsStatusLabel"
                                   IsVisible="False"
                                   FontSize="12"
                                   TextColor="{StaticResource TextTertiary}" />
                            <Label x:Name="ImprovementsLabel"
                                   IsVisible="False"
                                   FontSize="13"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- ============================== ICEBREAKERS ============================== -->
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">

                <Label Text="ICEBREAKERS" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                <Label Text="Edit the text directly, save your changes, or use Custom AI Prompt to generate a new personalized version."
                       Style="{StaticResource DescriptionStyle}" />
                <Label Text="CUSTOM AI PROMPT" Style="{StaticResource CaptionStyle}" Margin="0" />
                <Editor x:Name="CustomAIPromptEditor"
                        Placeholder="Example: Mention the storytelling in their latest video and keep it under 20 words."
                        HeightRequest="90" />
                <Grid ColumnDefinitions="*">
                    <Button x:Name="CustomAIPromptButton"
                            Text="Custom AI Prompt"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Clicked="OnCustomAIPromptClicked" />
                </Grid>

                <!--
                    The icebreakers are laid out with BindableLayout instead of a
                    CollectionView: this content sits inside a ScrollView, and a
                    CollectionView nested in a ScrollView is measured with no height,
                    which can silently render nothing.
                -->
                <VerticalStackLayout x:Name="OpenersStack"
                                     Spacing="8"
                                     Margin="0,8,0,0"
                                     IsVisible="False">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Opener">
                            <Frame Padding="12"
                                   Margin="0"
                                   BackgroundColor="{StaticResource SurfaceVariant}"
                                   BorderColor="{StaticResource Border}"
                                   CornerRadius="8"
                                   HasShadow="False">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <Editor Grid.Column="0"
                                           Text="{Binding Text, Mode=TwoWay}"
                                           Placeholder="Write or edit this icebreaker"
                                           HeightRequest="72"
                                           Margin="0"
                                           AutoSize="TextChanges" />
                                    <Button Grid.Column="1"
                                            Text="Save"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Clicked="OnSaveOpenerClicked"
                                            VerticalOptions="Center" />
                                    <Button Grid.Column="2"
                                            Text="Delete"
                                            Style="{StaticResource CompactDangerButtonStyle}"
                                            Clicked="OnDeleteOpenerClicked"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label x:Name="NoOpenersLabel"
                       Text="No icebreakers yet. Generate one above."
                       FontSize="12"
                       TextColor="{StaticResource TextTertiary}" />

                    </VerticalStackLayout>
                </Frame>

                <!-- ============================== SEND EMAIL ============================== -->
                <!--
                    A one-off send for this single lead, so the user does not have
                    to build a whole campaign to reach one person. The compose and
                    send flow mirrors SendEmailsPage exactly (same token engine,
                    same account picker wiring, same validator gate) - the only
                    difference is that the recipient is fixed to this contact.
                -->
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="SEND EMAIL" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                        <Label Text="Write a one-off email to this lead. Tokens like [f_name] or [snapshot_1] fill in per-recipient when you send."
                               Style="{StaticResource DescriptionStyle}" />

                        <Label Text="TO" Style="{StaticResource CaptionStyle}" Margin="0" />
                        <Entry x:Name="DirectToEntry"
                               Keyboard="Email"
                               Placeholder="lead@example.com" />

                        <Label Text="SEND FROM" Style="{StaticResource CaptionStyle}" Margin="0" />
                        <Picker x:Name="DirectAccountPicker"
                                Title="Select an account..."
                                SelectedIndexChanged="OnDirectAccountSelected" />

                        <Label Text="SUBJECT" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" />
                        <Entry x:Name="DirectSubjectEntry"
                               Placeholder="A quick idea for your next video"
                               Margin="0"
                               Focused="OnDirectSubjectFocused"
                               Unfocused="OnDirectSubjectUnfocused" />
                        <HorizontalStackLayout x:Name="DirectSubjectTokenBar"
                                               Spacing="8"
                                               Margin="0,2,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Button Text="{Binding Label}"
                                            CommandParameter="{Binding Token}"
                                            Clicked="OnDirectTokenClicked"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            FontSize="12"
                                            Padding="10,6"
                                            Margin="0"
                                            MinimumHeightRequest="32"
                                            HeightRequest="32" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>

                        <Label Text="MESSAGE" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" />
                        <Editor x:Name="DirectBodyEditor"
                                Placeholder="Hi [f_name], I loved your video on [channel]..."
                                HeightRequest="150"
                                AutoSize="TextChanges"
                                Margin="0"
                                Focused="OnDirectBodyFocused"
                                Unfocused="OnDirectBodyUnfocused" />
                        <HorizontalStackLayout x:Name="DirectBodyTokenBar"
                                               Spacing="8"
                                               Margin="0,2,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Button Text="{Binding Label}"
                                            CommandParameter="{Binding Token}"
                                            Clicked="OnDirectTokenClicked"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            FontSize="12"
                                            Padding="10,6"
                                            Margin="0"
                                            MinimumHeightRequest="32"
                                            HeightRequest="32" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <Label x:Name="DirectTokenHintLabel"
                               FontSize="11"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource TextTertiary}"
                               Text="Tokens resolve when you send: [snapshot_1] is this lead's first captured frame." />

                        <!-- Test Email: sends the exact same message to an address
                             you control instead of the lead, so personalization and
                             images can be checked without risking a bad first contact. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,8,0,0">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Test Email" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Send to the address below instead of this lead."
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Switch x:Name="TestEmailSwitch"
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Toggled="OnTestEmailToggled" />
                        </Grid>
                        <Entry x:Name="TestEmailEntry"
                               IsVisible="False"
                               Keyboard="Email"
                               Placeholder="you@example.com" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button x:Name="DirectPreviewButton"
                                    Grid.Column="0"
                                    Text="Preview"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Clicked="OnDirectPreviewClicked" />
                            <Button x:Name="DirectSendButton"
                                    Grid.Column="1"
                                    Text="Send"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Clicked="OnDirectSendClicked" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <ActivityIndicator x:Name="DirectSendIndicator"
                                               Grid.Column="0"
                                               IsRunning="False"
                                               IsVisible="False"
                                               VerticalOptions="Center" />
                            <Label x:Name="DirectSendStatusLabel"
                                   Grid.Column="1"
                                   FontSize="12"
                                   LineBreakMode="WordWrap"
                                   TextColor="{StaticResource TextTertiary}"
                                   VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!--
            Save / Delete live in a fixed bar outside the scroll area, in their own
            bordered frame, so they stay reachable however long the page grows and
            read as a page-level action rather than another section of content.
        -->
        <Frame Grid.Row="1"
               Margin="0,8,0,0"
               Padding="12"
               BackgroundColor="{StaticResource Surface}"
               BorderColor="{StaticResource Border}"
               CornerRadius="12"
               HasShadow="False">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="Save"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Clicked="OnSave" />
                <Button Grid.Column="1"
                        Text="Delete"
                        Style="{StaticResource DangerButtonStyle}"
                        Clicked="OnDelete" />
            </Grid>
        </Frame>

    </Grid>
</ContentPage>
