<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TubeMailGorilla.Maui.Unlocked.Models"
             x:Class="TubeMailGorilla.Maui.Unlocked.Views.ContactDetailsPage">
    <!-- No nav bar and no "Contact Details" title: AppShell hides nav bars
         app-wide (see AppShell.xaml), and opting this one back in left either an
         ugly heading or an empty blank strip. The page matches every other page
         in the app instead, and the back affordance is an ordinary button at the
         top of the content. -->
    <Grid Padding="20" RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0" HorizontalOptions="FillAndExpand">
            <VerticalStackLayout Spacing="0">

                <Button x:Name="BackButton"
                        Text="←  Back to contacts"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Padding="0"
                        Margin="0,0,0,8"
                        HorizontalOptions="Start"
                        FontSize="13"
                        TextColor="{StaticResource Primary}"
                        Clicked="OnBackClicked" />

                <!-- Contact info (editable) -->
                <Entry x:Name="NameEntry" Placeholder="Name" />
                <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />

                <!-- Lead context (read-only) -->
                <Label Text="LEAD CONTEXT" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,4" />
                <Frame Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,16" CornerRadius="8">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Channel, StringFormat='Channel: {0}', TargetNullValue='Channel: (unknown)'}"
                               FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding VideoTitle, StringFormat='Latest video: {0}', TargetNullValue='Video: (unknown)'}"
                               FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding VideoDescription, StringFormat='Description: {0}', TargetNullValue='Description: (unknown)'}"
                               FontSize="12" TextColor="{StaticResource TextTertiary}"
                               LineBreakMode="WordWrap" MaxLines="3" />
                        <Label Text="{Binding ExtractedAt, StringFormat='Extracted: {0:g}'}"
                               FontSize="12" TextColor="{StaticResource TextTertiary}" />
                        <Label Text="{Binding IsEmailer, StringFormat='Newsletter sender: {0}'}"
                               FontSize="12" TextColor="{StaticResource TextTertiary}" />
                    </VerticalStackLayout>
                </Frame>

                <!--
                    Video snapshots captured during extraction. A CarouselView
                    (not a BindableLayout) is used deliberately: it is the only
                    MAUI layout that handles both horizontal paging and lazy
                    image loading, which matters once a lead carries a dozen
                    base64 JPEGs. It sits inside a ScrollView, so it is given an
                    explicit height (a nested CollectionView measured without
                    one renders nothing).
                -->
                <!-- The three lead actions, in one row.

                     They were previously split: Generate sat down in ICEBREAKERS
                     and Improve sat on its own above it, so the eye had to travel
                     between two blocks to find what you can do with a lead. They
                     are one workflow, so they sit together.

                     Three equal columns rather than a HorizontalStackLayout: the
                     labels differ a lot in length, and auto-sizing would leave
                     the first button stretched and the last one cramped. Equal
                     columns keep the row reading as a single control. -->
                <Grid Margin="0,16,0,0"
                      ColumnDefinitions="*,*,*"
                      ColumnSpacing="8"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="6">
                    <Button x:Name="ActionIcebreakerButton"
                            Grid.Row="0" Grid.Column="0"
                            Text="&#x2728; Icebreaker"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Clicked="OnGenerateIcebreakerClicked" />
                    <Button x:Name="ActionImprovementsButton"
                            Grid.Row="0" Grid.Column="1"
                            Text="&#x1F50D; Video Review"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Clicked="OnIdentifyImprovementsClicked" />
                    <Button x:Name="ActionDownloadButton"
                            Grid.Row="0" Grid.Column="2"
                            Text="&#x2B07; Save ZIP"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Clicked="OnDownloadSnapshotsClicked" />

                    <Label x:Name="ActionRowHintLabel"
                           Grid.Row="1" Grid.ColumnSpan="3"
                           FontSize="11"
                           LineBreakMode="WordWrap"
                           TextColor="{StaticResource TextTertiary}"
                           HorizontalTextAlignment="Center" />
                </Grid>

                <!-- Video snapshots. -->
                <Label Text="VIDEO SNAPSHOTS" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,4" />
                <Label x:Name="SnapshotsHintLabel"
                       Text="A frame every 10 seconds of the video. Swipe to move through it."
                       Style="{StaticResource DescriptionStyle}" />

                <Grid x:Name="SnapshotsPanel" IsVisible="False" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CarouselView x:Name="SnapshotsCarousel"
                                   Grid.Row="0"
                                   HeightRequest="190"
                                   IsSwipeEnabled="True"
                                   IsBounceEnabled="False"
                                   PositionChanged="OnSnapshotPositionChanged">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="models:VideoSnapshotItem">
                                <Border Padding="0"
                                        StrokeThickness="0"
                                        BackgroundColor="Transparent">
                                    <Grid>
                                        <Image Source="{Binding Image, Converter={StaticResource Base64ToImageSource}}"
                                               Aspect="AspectFit" />
                                        <Label Text="{Binding TimestampLabel}"
                                               HorizontalOptions="End"
                                               VerticalOptions="Start"
                                               Margin="0,6,6,0"
                                               Padding="6,2"
                                               FontSize="11"
                                               FontFamily="JetBrainsMono"
                                               TextColor="White"
                                               BackgroundColor="#CC000000" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <!-- Position indicator + paging buttons: the carousel is swipe
                         first, and these make every snapshot reachable with a
                         mouse or keyboard too. -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                        <Button x:Name="PreviousSnapshotButton"
                                Grid.Column="0"
                                Text="◀"
                                WidthRequest="44"
                                Padding="0"
                                FontSize="14"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Clicked="OnPreviousSnapshotClicked" />
                        <Label x:Name="SnapshotCounterLabel"
                               Grid.Column="1"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}" />
                        <Button x:Name="NextSnapshotButton"
                                Grid.Column="2"
                                Text="▶"
                                WidthRequest="44"
                                Padding="0"
                                FontSize="14"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Clicked="OnNextSnapshotClicked" />
                    </Grid>

                    <!-- Jump to the moment the frame on screen was captured. -->
                    <Button x:Name="SnapshotWatchButton"
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            Text="Watch from this moment"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Clicked="OnWatchSnapshotClicked"
                            IsVisible="False" />
                </Grid>

                <Label x:Name="NoSnapshotsLabel"
                       Text="This lead has no snapshots. They are captured during extraction, so only leads found after that ran will have them."
                       FontSize="12"
                       TextColor="{StaticResource TextTertiary}"
                       IsVisible="False" />

                <!-- The AI review result lives outside the snapshot panel on purpose:
                     it works from the transcript and metadata as well as the frames,
                     so it must stay available for a lead that has no snapshots.
                     The button itself now lives in the action row above. -->

                <!-- AI video review results. -->
                <Grid x:Name="ImprovementsPanel" IsVisible="False" Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Text="AREAS OF IMPROVEMENT" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="Editing notes aimed at raising watch time and engagement on this video."
                           Style="{StaticResource DescriptionStyle}" />

                    <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="0,8,0,0">
                        <ActivityIndicator x:Name="ImprovementsIndicator"
                                           IsRunning="False"
                                           IsVisible="False"
                                           HorizontalOptions="Center" />
                        <Label x:Name="ImprovementsStatusLabel"
                               IsVisible="False"
                               FontSize="12"
                               TextColor="{StaticResource TextTertiary}" />
                        <Label x:Name="ImprovementsLabel"
                               IsVisible="False"
                               FontSize="13"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>

                <!-- AI Icebreakers -->
                <Label Text="ICEBREAKERS" Style="{StaticResource SectionTitleStyle}" />
                <Label Text="Edit the text directly, save your changes, or use Custom AI Prompt to generate a new personalized version."
                       Style="{StaticResource DescriptionStyle}" />
                <Label Text="CUSTOM AI PROMPT" Style="{StaticResource CaptionStyle}" Margin="0,8,0,4" />
                <Editor x:Name="CustomAIPromptEditor"
                        Placeholder="Example: Mention the storytelling in their latest video and keep it under 20 words."
                        HeightRequest="90" />
                <Grid ColumnDefinitions="*" Margin="0,8,0,0">
                    <Button x:Name="CustomAIPromptButton"
                            Text="Custom AI Prompt"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Clicked="OnCustomAIPromptClicked" />
                </Grid>

                <!--
                    The icebreakers are laid out with BindableLayout instead of a
                    CollectionView: this content sits inside a ScrollView, and a
                    CollectionView nested in a ScrollView is measured with no height,
                    which can silently render nothing.
                -->
                <VerticalStackLayout x:Name="OpenersStack"
                                     Spacing="8"
                                     Margin="0,8,0,0"
                                     IsVisible="False">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Opener">
                            <Frame Padding="12"
                                   Margin="0"
                                   BackgroundColor="{StaticResource SurfaceVariant}"
                                   BorderColor="{StaticResource Border}"
                                   CornerRadius="8"
                                   HasShadow="False">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <Editor Grid.Column="0"
                                           Text="{Binding Text, Mode=TwoWay}"
                                           Placeholder="Write or edit this icebreaker"
                                           HeightRequest="72"
                                           Margin="0"
                                           AutoSize="TextChanges" />
                                    <Button Grid.Column="1"
                                            Text="Save"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Clicked="OnSaveOpenerClicked"
                                            VerticalOptions="Center" />
                                    <Button Grid.Column="2"
                                            Text="Delete"
                                            Style="{StaticResource CompactDangerButtonStyle}"
                                            Clicked="OnDeleteOpenerClicked"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label x:Name="NoOpenersLabel"
                       Text="No icebreakers yet. Generate one above."
                       FontSize="12"
                       TextColor="{StaticResource TextTertiary}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Save / Delete buttons -->
        <HorizontalStackLayout Grid.Row="1" Spacing="12" HorizontalOptions="Center">
            <Button Text="Save" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSave" />
            <Button Text="Delete" Style="{StaticResource DangerButtonStyle}" Clicked="OnDelete" />
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
