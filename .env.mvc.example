# ---------------------------------------------------------------------------
# TubeMailGorilla MVC website - environment variables for the Linux VPS.
#
# Copy this to .env (gitignored) and fill in the real values before running:
#   cp .env.mvc.example .env
#
# The Compose file (docker-compose.mvc.yml) reads these variables. The MVC app
# does NOT use them directly; they are turned into ASP.NET Core configuration
# via the Compose `environment:` block (e.g. JwtSettings__Secret -> JwtSettings:Secret).
#
# DEFAULT STORAGE:
#   The MVC compose file defaults to SQLite (DataStorage__Provider=Sqlite) with a
#   persistent Docker volume holding /app/data/tubemailgorilla.db. If you prefer
#   MySQL instead, set DataStorage__Provider= and set
#   ConnectionStrings__DefaultConnection to your MySQL server.
#
# IMPORTANT: Never commit real credentials to .env.
# ---------------------------------------------------------------------------

# ---- Storage ----
# Required for SQLite. Do NOT leave this blank unless you want MySQL.
DATA_STORAGE_PROVIDER=Sqlite

# ---- MySQL (only used if DataStorage__Provider is not Sqlite) ----
DB_HOST=db
DB_PORT=3306
MYSQL_DATABASE=TubeMailGorillaDB
MYSQL_USER=tmg
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---- ASP.NET Core ----
ASPNETCORE_ENVIRONMENT=Production
MVC_PORT=8181

# ---- JWT ----
JWT_SECRET=
JWT_ISSUER=TubeMailGorillaAPI
JWT_AUDIENCE=TubeMailGorillaClient
JWT_EXPIRY_MINUTES=1440

# ---- PayPal ----
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_PLAN_ID=

# ---- Admin seed (initial admin created on first run) ----
ADMIN_SEED_EMAIL=admin@tubemailgorilla.com
ADMIN_SEED_PASSWORD=

# ---- Subscription plan overrides (optional) ----
# If blank, the built-in appsettings.json catalog is used.
SUBSCRIPTION_PLAN_0_ID=pro
SUBSCRIPTION_PLAN_0_NAME=Pro
SUBSCRIPTION_PLAN_0_TAGLINE=Everything you need to find clients and land paid editing work.
SUBSCRIPTION_PLAN_0_MONTHLY_PRICE=9.99
SUBSCRIPTION_PLAN_0_CURRENCY=USD
SUBSCRIPTION_PLAN_0_LEADS_PER_MONTH=5000
SUBSCRIPTION_PLAN_0_IS_ENABLED=true

FREE_PLAN_MAX_LEADS=5
FREE_PLAN_MAX_CONTACTS=5
FREE_PLAN_MAX_EMAILS=5
