# ---------------------------------------------------------------------------
# Copy this file to `.env` on the VPS (same directory as docker-compose.yml)
# and fill in real values. DO NOT commit `.env`.
#
#   cp .env.example .env
#   nano .env
#   docker compose up -d --build
# ---------------------------------------------------------------------------

# ---- Database ----
MYSQL_DATABASE=TubeMailGorillaDB
MYSQL_USER=tmg
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# ---- API ----
# Port the API container is exposed on the host (reverse proxy forwards here).
API_PORT=8080

# JWT signing key - use a long random string, e.g.:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET
JWT_ISSUER=TubeMailGorillaAPI
JWT_AUDIENCE=TubeMailGorillaClient
JWT_EXPIRY_MINUTES=1440

# ---- PayPal ----
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_SECRET=CHANGE_ME
PAYPAL_MODE=sandbox
PAYPAL_PLAN_ID=CHANGE_ME

# ---- CORS ----
# Origins (no trailing slash) allowed to call the API. Usually your web app URL.
CORS_ORIGIN_0=https://app.tubemailgorilla.com
CORS_ORIGIN_1=http://localhost:3000