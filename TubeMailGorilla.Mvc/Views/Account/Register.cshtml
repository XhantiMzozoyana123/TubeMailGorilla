@model TubeMailGorilla.Mvc.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}

<h1>Create your account</h1>

<div class="auth-card">
    <form asp-action="Register" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-field">
            <label asp-for="FullName"></label>
            <input asp-for="FullName" autocomplete="name" />
        </div>
        <div class="form-field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" />
        </div>
        <div class="form-field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password" />
        </div>
        <div class="form-field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Create account</button>
    </form>
    <p class="auth-alt">
        Already have an account? <a asp-action="Login">Log in</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
