@{
    ViewData["Title"] = "TubeMail Gorilla - Find creators, land clients";
}

<section class="hero">
    <h1>Turn YouTube creators into <span class="accent">paying clients</span>.</h1>
    <p class="lead">
        TubeMail Gorilla finds creator contact leads from YouTube, writes AI-personalized
        pitch emails, and runs your outreach campaigns - from one account on the web and desktop.
    </p>
    <div class="hero-actions">
        <a class="btn btn-primary" href="/pricing">See pricing</a>
        <a class="btn btn-secondary" asp-controller="Account" asp-action="Register">Create free account</a>
    </div>
</section>

<section class="features">
    <div class="feature">
        <h3>Extract leads</h3>
        <p>Search any niche keyword and pull verified creator emails from video descriptions and captions.</p>
    </div>
    <div class="feature">
        <h3>AI icebreakers</h3>
        <p>Every email opens with a personalized first line referencing the creator's actual content.</p>
    </div>
    <div class="feature">
        <h3>Campaigns</h3>
        <p>Send from your own SMTP accounts with rotation, message variations and delivery tracking.</p>
    </div>
</section>
