@model TubeMailGorilla.Mvc.Models.ContactDetailsViewModel
@{
    ViewData["Title"] = "Contact Details";
    var contact = Model.Contact;
}

<a class="back-link" asp-controller="Contacts" asp-action="Index">&#x2039; Contacts</a>

<div class="page-header">
    <h1 class="section-title">CONTACT DETAILS</h1>
    <p class="description">Edit the name or email below, then Save. Delete removes this contact.</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-error">@Model.Error</div>
}

@* Contact info (editable) *@
<h2 class="section-title">CONTACT INFO</h2>
<form method="post" asp-controller="Contacts" asp-action="Save">
    <input type="hidden" name="id" value="@contact.Id" />
    <input type="text" name="name" value="@contact.Name" placeholder="Name" />
    <input type="email" name="email" value="@contact.Email" placeholder="Email" />
    <div class="actions-center">
        <button type="submit" class="btn btn-primary">Save</button>
        @if (!Model.IsNew)
        {
            <button type="button" class="btn btn-danger"
                    onclick="document.getElementById('deleteContactForm').submit();">Delete</button>
        }
    </div>
</form>

@* Lead context (read-only) *@
<h2 class="section-title" style="margin-top: 20px;">LEAD CONTEXT</h2>
<div class="info-card">
    <p>@(string.IsNullOrWhiteSpace(contact.Channel) ? "Channel: (unknown)" : $"Channel: {contact.Channel}")</p>
    <p>@(string.IsNullOrWhiteSpace(contact.VideoTitle) ? "Video: (unknown)" : $"Latest video: {contact.VideoTitle}")</p>
    <p>@(string.IsNullOrWhiteSpace(contact.VideoDescription) ? "Description: (unknown)" : $"Description: {contact.VideoDescription}")</p>
    <p>Extracted: @contact.ExtractedAt.ToString("g")</p>
    <p>Newsletter sender: @contact.IsEmailer</p>
</div>

@* AI Icebreakers *@
<h2 class="section-title">AI ICEBREAKERS</h2>
<p class="description">
    Personalized first lines generated from this lead's channel and video. Pick the best one for your email.
</p>

@if (!Model.IsNew)
{
    <form method="post" asp-controller="Contacts" asp-action="GenerateIcebreaker" class="js-busy">
        <input type="hidden" name="id" value="@contact.Id" />
        <button type="submit" class="btn btn-primary btn-block" data-busy-target="this">
            &#x2728; Generate Icebreaker
        </button>
    </form>
}

@foreach (var opener in Model.Openers)
{
    <div class="opener-item">
        <span class="opener-text">@opener.Text</span>
        <form method="post" asp-controller="Contacts" asp-action="DeleteOpener">
            <input type="hidden" name="openerId" value="@opener.Id" />
            <input type="hidden" name="id" value="@contact.Id" />
            <button type="submit" class="btn btn-compact-danger">Delete</button>
        </form>
    </div>
}
@if (Model.Openers.Count == 0)
{
    <p class="list-meta">No icebreakers yet. Generate one above.</p>
}

@if (!Model.IsNew)
{
    <form id="deleteContactForm" method="post" asp-controller="Contacts" asp-action="Delete"
          class="js-confirm" data-confirm="Remove &quot;@contact.Email&quot; from your contacts?">
        <input type="hidden" name="id" value="@contact.Id" />
    </form>
}

