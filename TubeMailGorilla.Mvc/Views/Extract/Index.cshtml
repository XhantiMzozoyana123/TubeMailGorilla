@using TubeMailGorilla.Mvc.Models
@model ExtractViewModel
@{
    ViewData["Title"] = "Extract";
    ViewData["Pad24"] = true; // ExtractPage uses ScrollView Padding="24"
}

<div class="page-header">
    <h1 class="section-title">EXTRACT LEADS</h1>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-error">@Model.Error</div>
}
@if (!Model.YtDlpAvailable)
{
    <div class="alert alert-error">
        <p><strong>yt-dlp was not found</strong>, so YouTube search and transcripts cannot run.</p>
        <p>Put the binary here:</p>
        <p><code>@Model.YtDlpExpectedPath</code></p>
        <p>
            Or install yt-dlp so it is on your PATH, or set <code>YtDlp:Path</code> in
            <code>appsettings.json</code> to its full path. The Docker image installs yt-dlp
            automatically, so this only affects local development.
        </p>
    </div>
}

@* EXTRACTION card (CollapsibleCard Title="EXTRACTION") *@
<section class="card">
    <div class="card-header">
        <span class="card-title">EXTRACTION</span>
        <span class="card-chevron">&#x25BE;</span>
    </div>
    <div class="card-divider"></div>
    <div class="card-body">
        <form method="post" asp-controller="Extract" asp-action="Run" class="js-busy">
            <label class="caption" for="keyword">KEYWORD</label>
            <input id="keyword" name="keyword" type="text" value="@Model.Keyword"
                   placeholder="e.g. marketing, tech review, fitness coach" />

            <label class="caption" for="pageViewLimit" style="margin-top: 8px;">PAGE LIMIT (MAX RESULTS)</label>
            <input id="pageViewLimit" name="pageViewLimit" type="number" min="1" max="50"
                   value="@Model.PageViewLimit" placeholder="e.g. 5" />

            <hr class="divider" />

            <button type="submit" class="btn btn-primary btn-block" data-busy-target="this">Start Extraction</button>
            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <p class="status">@Model.StatusMessage</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.LlmStatus))
            {
                <p class="status">AI: @Model.LlmStatus</p>
            }
        </form>

        @* Background run progress. Extraction now runs on the Hangfire server,
           so this polls a status endpoint instead of blocking the request. *@
        @if (Model.ActiveJob is not null)
        {
            <div class="info-card" id="extraction-progress"
                 data-job-id="@Model.ActiveJob.JobId"
                 data-active="@Model.ActiveJob.IsActive.ToString().ToLowerInvariant()"
                 style="margin-top: 12px;">
                <p>
                    <strong>@Model.ActiveJob.Keyword</strong>
                    &mdash; <span data-field="state">@Model.ActiveJob.State</span>
                    (<span data-field="elapsed">@Model.ActiveJob.ElapsedLabel</span>)
                </p>
                <p data-field="message">@Model.ActiveJob.Message</p>
                <p class="list-meta">
                    Videos: <span data-field="videos">@Model.ActiveJob.TotalVideos</span>
                    &middot; Leads: <span data-field="emails">@Model.ActiveJob.EmailsFound</span>
                    &middot; Errors: <span data-field="errors">@Model.ActiveJob.Errors</span>
                </p>
                <p class="list-meta"><a href="/hangfire" target="_blank" rel="noopener">Open the job dashboard</a></p>
            </div>
        }

        @if (Model.RecentJobs.Count > 0)
        {
            <div class="info-card" style="margin-top: 12px;">
                <p class="list-meta" style="margin-bottom: 6px;">RECENT RUNS</p>
                @foreach (var run in Model.RecentJobs)
                {
                    <p class="list-meta">
                        @run.Keyword &mdash; @run.State &mdash; @run.ElapsedLabel
                        @if (run.TotalVideos > 0)
                        {
                            <span> (videos: @run.TotalVideos, leads: @run.EmailsFound)</span>
                        }
                    </p>
                }
            </div>
        }

        <hr class="divider" />

        <label class="caption">BULK EXTRACT FROM CSV (OPTIONAL)</label>
        <p class="section-subtitle">
            Have a whole list of keywords? Upload one CSV and every search runs back-to-back — no typing, waiting, repeating.
        </p>

        <a class="btn btn-secondary btn-block" asp-controller="Extract" asp-action="BulkTemplate">
            Download CSV Bulk Extraction Template
        </a>

        <form method="post" asp-controller="Extract" asp-action="Bulk"
              enctype="multipart/form-data" class="js-busy">
            <input type="file" name="file" accept=".csv,.txt" style="margin-bottom: 12px;" />
            <button type="submit" class="btn btn-primary btn-block" data-busy-target="this">
                Upload CSV &amp; Start Bulk Extracting
            </button>
        </form>
        @if (!string.IsNullOrWhiteSpace(Model.BulkStatusMessage))
        {
            <p class="status">@Model.BulkStatusMessage</p>
        }
    </div>
</section>

@* RESULTS card *@
<section class="card">
    <div class="card-header">
        <span class="card-title">RESULTS</span>
        <span class="card-chevron">&#x25BE;</span>
    </div>
    <div class="card-divider"></div>
    <div class="card-body">
        <p class="section-subtitle" style="margin-bottom: 0;">
            @(Model.ResultsLabel ?? "Extracted contacts are saved and viewable on the Contacts page.")
        </p>
    </div>
</section>
