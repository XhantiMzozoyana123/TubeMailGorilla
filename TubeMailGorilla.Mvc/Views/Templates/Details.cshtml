@model TubeMailGorilla.Mvc.Models.TemplateDetailsViewModel
@{
    ViewData["Title"] = "Email Template";
    var template = Model.Template;
}

<a class="back-link" asp-controller="Templates" asp-action="Index">&#x2039; Email Templates</a>

<div class="page-header">
    <h1 class="section-title">EMAIL TEMPLATE</h1>
    <p class="description">Name this template and fill in the subject and body used when sending campaigns.</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-error">@Model.Error</div>
}

<form method="post" asp-controller="Templates" asp-action="Save">
    <input type="hidden" name="id" value="@template.Id" />
    <input type="text" name="name" value="@template.Name" placeholder="Template name (e.g. Outreach)" />
    <input type="text" name="subject" value="@template.Subject" placeholder="Email subject line" />
    <textarea name="body" rows="8" style="min-height: 180px;"
              placeholder="Write your email body here. Use tokens like [name], [email], [channel], [video-title], [descr], [channel-name], [first-name], [last-name].">@template.Body</textarea>

    <div class="actions-center">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary" asp-controller="Templates" asp-action="Index">Cancel</a>
    </div>
</form>
