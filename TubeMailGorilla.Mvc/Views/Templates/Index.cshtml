@model List<TubeMailGorilla.Mvc.Models.EmailTemplate>
@{
    ViewData["Title"] = "Email Templates";
}

<div class="page-header">
    <h1 class="section-title">EMAIL TEMPLATES</h1>
    <p class="description">Stored email templates. Add a new template, or tap a row to edit it.</p>
</div>

@if (Model.Count == 0)
{
    <p class="empty-state">No email templates yet. Add one to start storing reusable campaigns.</p>
}
else
{
    <div style="margin-bottom: 12px;">
        @foreach (var template in Model)
        {
            <div class="list-row">
                <a class="list-main" asp-controller="Templates" asp-action="Details" asp-route-id="@template.Id"
                   style="text-decoration: none; color: inherit;">
                    <div class="list-title lg">@template.Name</div>
                    <div class="list-sub">@template.Subject</div>
                    <div class="list-meta">
                        @(template.UpdatedAt is DateTime updated
                            ? $"Updated {updated:g}"
                            : $"Created {template.CreatedAt:g}")
                    </div>
                </a>
                <form method="post" asp-controller="Templates" asp-action="Delete"
                      class="js-confirm"
                      data-confirm="Remove '@template.Name' from your email templates?">
                    <input type="hidden" name="id" value="@template.Id" />
                    <button type="submit" class="btn-toolbar">Delete</button>
                </form>
            </div>
        }
    </div>
}

<a class="btn btn-secondary btn-block" asp-controller="Templates" asp-action="Details">Add Template</a>
