@using System.Security.Claims
@using TubeMailGorilla.Mvc
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TubeMail Gorilla</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* Shell hides navigation bars app-wide (AppShell.xaml Shell.NavBarIsVisible="False"):
       the app is just content plus the bottom TabBar. *@
    <main class="app-main @(ViewData["Pad24"] as bool? == true ? "pad-24" : null)">
        @if (TempData["StatusMessage"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success">@ok</div>
        }
        @if (TempData["StatusError"] is string err && !string.IsNullOrWhiteSpace(err))
        {
            <div class="alert alert-error">@err</div>
        }
        @RenderBody()
    </main>

    @{
        // TabBar titles/order come straight from AppShell.xaml.
        var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLowerInvariant();
        string Active(params string[] names) =>
            names.Contains(controller) ? "active" : "";
    }
    <nav class="tab-bar" aria-label="App tabs">
        <a class="tab @Active("extract")" asp-controller="Extract" asp-action="Index">Extract</a>
        <a class="tab @Active("sendemails")" asp-controller="SendEmails" asp-action="Index">Send Emails</a>
        <a class="tab @Active("contacts")" asp-controller="Contacts" asp-action="Index">Contacts</a>
        <a class="tab @Active("blocked")" asp-controller="Blocked" asp-action="Index">Blocked</a>
        <a class="tab @Active("templates")" asp-controller="Templates" asp-action="Index">Email Templates</a>
        <a class="tab @Active("unlocked", "subscription")" asp-controller="Unlocked" asp-action="Index">Unlocked</a>
        <a class="tab @Active("settings")" asp-controller="Settings" asp-action="Index">Settings</a>
    </nav>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

